# ── Manager · UX 鉴权（代理数据中心 users/login）──
# 本地 Mock 联调（须先启动 mock + manager）：
#   python agent/.local/mock_datacenter.py
# DATA_CENTER_BASE_URL=http://127.0.0.1:9000
# MANAGER_PORT=8000
# 远端数据中心：
# DATA_CENTER_BASE_URL=http://10.143.2.231:8000
# AIDA_AGENT_BASE_URL=http://127.0.0.1:7401

# ─── AIDA Agent 环境变量模板 ───
# 复制为 agent/.env 后填入真实值：
#   cp agent/.env.example agent/.env

# ── LLM · 智谱 BigModel（必填）──
ZHIPU_API_KEY=359fcb54aad04a45826889029af4c3f1.3mVmFkfarYF8y7IY

# ── 可观测 · Langfuse（可选，评测看板需要）──
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 运行时热插拔 skill（零重启 · 可选）──
# 设置后启用 POST /agent/admin/reload（放/改 agent/skills/<name>/ 目录包后调一次即生效，进程不重启）。
# fail-closed：不设则该端点禁用（503）。调用带 Authorization: Bearer <此值>。生产务必设强随机串。
# AIDA_ADMIN_TOKEN=change-me-dev-token

# ── 业务场景 Skill工作区路径（可选，有默认值）──
# zhgk（智慧工勘）工作区，默认 ~/.nanobot/workspace/skills/zhgk
# ZHGK_ROOT=C:/Users/yourname/Desktop/zhgk-desktop

# guihua（规划设计）工作区，默认 ~/.nanobot/workspace/skills/jmfz
# GUIHUA_ROOT=C:/Users/yourname/Desktop/guihua-workspace
#
# guihua 仿真 API（nVisual / wapi 网关，默认 dry-run）
# 不设 SIM_API_LIVE 时全程离线（fixture 兜底），设为 1 或 true 时真发仿真网关：
# SIM_API_LIVE=1
# SIM_API_BASE=http://100.102.191.17:9091
# SIM_API_TOKEN=<Bearer token，有内置默认值，可覆盖>
# SIM_WEB_URL=http://100.102.191.17:9090/access.html?v=2.25.3

# system_design（系统设计）数据根 · 上传 → ProjectData/Input · 产物 → ProjectData/Output
# 建议与 GUIHUA_ROOT 共用同一目录，使建模仿真产出可被 input_check 自动识别
# SYSTEM_DESIGN_ROOT=d:/path/to/your/a3-project
# A3_ROOT=d:/path/to/your/a3-project

# software_deployment（部署调测）工作区，默认仓库内 skills/software_deployment/
# SOFTWARE_DEPLOYMENT_ROOT=C:/path/to/AIDA/skills/software_deployment
# SD_PROJECTS_JSON=C:/path/to/AIDA/skills/software_deployment/data/projects.json

# device_install（设备安装）· 服务器/数据中心落点（Linux）。可二选一：
#
# 方式 A（推荐 · 零配置）：确保 /opt/aida/aida-data/business 存在且项目目录下有
#   .../项目管理/计划/输出结果/设备安装实施计划.xlsx，Agent 会自动扫描定位。
#   可选 AIDA_DEFAULT_PROJECT_ID=<UUID32> 指定项目（多项目时必填）。
#
# 方式 B（显式三路径）：
#   DEVICE_INSTALL_ROOT        工作根（运行态 RunTime/Input/Images 落 <root>/ProjectData/）
#   DEVICE_INSTALL_SOURCE_ROOT 上游《设备安装实施计划.xlsx》读取目录
#   DEVICE_INSTALL_OUTPUT_ROOT 作业产物输出目录（不设则默认 <root>/ProjectData/Output）
#
# AIDA_BUSINESS_ROOT=/opt/aida/aida-data/business
# AIDA_DEFAULT_PROJECT_ID=1b9bb4a0d0ce4863925e787bc057ecaf
# DEVICE_INSTALL_ROOT=/opt/aida/aida-data/business/projects/1b9bb4a0d0ce4863925e787bc057ecaf/交付作业/设备安装
# DEVICE_INSTALL_SOURCE_ROOT=/opt/aida/aida-data/business/projects/1b9bb4a0d0ce4863925e787bc057ecaf/项目管理/计划/输出结果
# DEVICE_INSTALL_OUTPUT_ROOT=/opt/aida/aida-data/business/projects/1b9bb4a0d0ce4863925e787bc057ecaf/交付作业/设备安装/输出结果

# ── 交付预案 Mock 数据根目录（0612 · 默认 aida/data/delivery/mock）──
# AIDA_MOCK_DATA_ROOT=../data/delivery/mock

# ── 邮件发送（默认 dry-run，不会真发）──
# Windows 华为内网推荐 Outlook COM（与 nanobot 一致，无需 SMTP 密码）：
# AIDA_SEND_EMAIL=1
# AIDA_MAIL_BACKEND=outlook
# 备选 nanobot outlook_service_full.py：
# AIDA_MAIL_BACKEND=outlook_http
# OUTLOOK_SERVICE_URL=http://127.0.0.1:5123


# ── GKCLAW 邮件链路（zhgk=backagent · 经 mailgw 网关收发任务包）──
# AIDA_SEND_EMAIL=1
# AIDA_MAIL_BACKEND=mailgw
# MAILGW_BASE=http://127.0.0.1:8025
# MAILGW_TOKEN=<mailgw 管理员签发的 Bearer token（.env 专属，禁入任务包/代码/文档）>
# GKCLAW_FRONTAGENT_MAILBOX=front-agent@example.com   # 任务包收件方（域名须在 mailgw 白名单）
# 发送走 AIDA_MAIL_BACKEND=mailgw；收件由 wait_survey 检查时拉取（无后台轮询）
