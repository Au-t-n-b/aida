    classDef task fill:#F8E8C8,stroke:#A86F1A,stroke-width:1px,color:#222;
    classDef milestone fill:#E8EEF7,stroke:#5E7FA8,stroke-width:1px,color:#222;
    classDef review fill:#E6F4EA,stroke:#4D8A5F,stroke-width:1px,color:#222;

    general_arrival["6.7 通算到货(含开箱验货)<br/>PoD级｜标准: /｜极限: /｜SLA: —"]
    room_server["2.3 机房改造实施(可装服务器)<br/>机房级｜SLA: —"]
    low_review["5.7 低阶设计评审<br/>项目级｜标准: 3天｜极限: 1天｜SLA: 固定"]
    clean["7.1 机房洁净度测试<br/>机房级｜标准: 5天｜极限: 3天｜SLA: 固定"]
    general_cable["6.4 通用线缆到货(含开箱验货)<br/>PoD级｜标准: /｜极限: /｜SLA: —"]
    wiring["7.2 综合布线与成端-通用线缆<br/>PoD级｜标准: 约728根/5天｜极限: 约728根/3天｜SLA: 弹性"]
    general_install["7.7 通算服务器安装<br/>PoD级｜标准: 30台/天｜极限: 50台/天｜SLA: 弹性"]
    power_on["7.8 通算设备上电<br/>批次级｜标准: 2天｜极限: 1天｜SLA: 固定"]
    accept["7.9 通算设备硬件验收<br/>PoD级｜标准: 1天｜极限: 1天｜SLA: 固定"]
    init["8.3 设备硬装初始化-通算服务器<br/>PoD级｜标准: 2天｜极限: 1天｜SLA: 固定"]
    deploy["8.9 计算子系统部署调测-通算服务器<br/>PoD级｜标准: 5天｜极限: 3天｜SLA: 固定"]

    general_arrival -->|FS| general_install
    room_server -->|FS| general_install
    low_review -->|FS| general_install

    room_server -->|FS| clean
    clean -->|FS| wiring
    general_cable -->|FS| wiring
    low_review -->|FS| wiring

    general_install -->|FS| power_on
    wiring -->|FS| power_on
    power_on -->|FS| accept
    power_on -->|FS| init
    init -->|FS| deploy

    class general_arrival,general_cable milestone;
    class low_review review;
    class room_server,clean,wiring,general_install,power_on,accept,init,deploy task;
