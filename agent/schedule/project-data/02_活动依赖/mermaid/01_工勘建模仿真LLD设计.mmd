    classDef task fill:#F8E8C8,stroke:#A86F1A,stroke-width:1px,color:#222;
    classDef external fill:#E8EEF7,stroke:#5E7FA8,stroke-width:1px,color:#222;
    classDef review fill:#E6F4EA,stroke:#4D8A5F,stroke-width:1px,color:#222;
    classDef note fill:#F7F7F7,stroke:#999,stroke-dasharray:3 3,color:#333;

    subgraph survey["工程勘测"]
        direction LR
        onsite["3.1 现场勘测<br/>项目级｜标准: 3天｜极限: 1天｜SLA: 固定"]
