# ============================================================
# AIDA 后端环境变量示例
# 用法：复制本文件为 .env（同目录），把占位符换成真实值（默认就配齐）。
# .env 已被根 .gitignore 忽略、永不入库；本 .example 只放占位符。
# ============================================================

# 百炼（阿里云 DashScope）—— 默认必配：填入你之前在「蓝区」自助申请的 API Key（系统后续功能都会用到）
BAILIAN_API_KEY=在此填入你在蓝区申请的百炼API-Key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 稀宇（MiniMax 国内版）—— 可选
XIYU_API_KEY=在此填入你的稀宇API-Key
XIYU_BASE_URL=https://api.minimaxi.com/v1

# 可选调参（不填走默认；详见 04 后端/模型调用手册.md）
# BAILIAN_TIMEOUT_SECONDS=90
# BAILIAN_LIVENESS_TIMEOUT_SECONDS=10
# BAILIAN_MAX_RETRIES=2
