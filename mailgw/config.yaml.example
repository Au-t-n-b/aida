smtp:
  host: smtp.corp.com
  port: 465
  ssl: true                 # true=SMTP_SSL；false=STARTTLS
  username: aida@corp.com
  from_addr: aida@corp.com
  display_name: AIDA 智能助手
pop3:
  host: pop3.corp.com
  port: 995
  ssl: true
  username: aida@corp.com

  poll_interval: 30         # 秒；演示自动回传建议 30~60；0 = 仅按需拉取
policy:
  whitelist_domains: ["corp.com"]
  whitelist_addresses: []
  hourly_limit: 20
  daily_limit: 100
  max_attachment_mb: 25
  max_recipients: 20
data_dir: ./data

# mailgw 收到 GKCLAW 邮件后 POST 通知 AIDA Agent。
# 容器演示编排中由 AGENT_NOTIFY_BASE=http://agent:7401 覆盖 base_url。
agent_notify:
  enabled: true
  base_url: http://127.0.0.1:7401
  # token 默认读环境变量 AGENT_NOTIFY_TOKEN 或 MAILGW_TOKEN_AIDA
  skill: zhgk
