{
  "schemaVersion": 1,
  "moduleId": "software_deployment",
  "flow": "software_deployment",
  "docId": "dashboard:software-deployment",
  "dataFile": "data/dashboard.json",
  "label": "软件部署与调测",
  "description": "十一步主线：计划 1～3、CloudOps 4～6（ZTP/测试参数为步骤 6 的可后补材料）、调测设备 7、Toolkit 联调 8～11；材料在 ProjectData/input/*，产物在 plan/Output。",
  "capabilities": {
    "hitl": true,
    "uploads": true,
    "taskProgressAutoSync": true,
    "metrics": ["kpi_cards"]
  },
  "uploads": [
    {
      "purpose": "sd-plan-receive-tasks",
      "label": "部署调测二级任务列表",
      "accept": ".xlsx,.json",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/plan_receive"
    },
    {
      "purpose": "sd-plan-split-testcase",
      "label": "项目验收用例（Word）",
      "accept": ".docx",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/plan_split"
    },
    {
      "purpose": "sd-plan-split-pod-map",
      "label": "机房-Pod 映射（多 Pod 必填）",
      "accept": ".xlsx",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/plan_split"
    },
    {
      "purpose": "sd-plan-dispatch-lld",
      "label": "LLD 设计文件（下发）",
      "accept": ".xlsx",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/plan_dispatch"
    },
    {
      "purpose": "sd-cloudops-manual",
      "label": "CloudOps 手工补充配置",
      "accept": ".xlsx",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/cloudops"
    },
    {
      "purpose": "sd-cloudops-checklist",
      "label": "设备安装完工清单（步骤 6）",
      "accept": ".xlsx",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/cloudops"
    },
    {
      "purpose": "sd-cloudops-ztp",
      "label": "灵衢 ZTP 开局文件（步骤 6 材料，可后补）",
      "accept": ".zip",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/cloudops"
    },
    {
      "purpose": "sd-cloudops-params",
      "label": "CloudOps 上传测试参数（步骤 6 材料，可后补）",
      "accept": ".xlsx",
      "multiple": false,
      "save_relative_dir": "ProjectData/input/cloudops"
    }
  ],
