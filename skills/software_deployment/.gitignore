ProjectData/plan/RunTime/*
!ProjectData/plan/RunTime/gateway.json

# User uploads under ProjectData/input/ stay local unless explicitly tracked as fixtures.

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ---- Temp ----
*.tmp
*.log
~$*
