# ── Jenkins Managed file 模板（fileId: aida-231-agent-env）──────────────────
# 231 宿主机已占用：AIDA 8080/8081/7401，数据中心 5173/8000 — Docker 勿 bind 这些端口。
# 容器访问数据中心 API 用 host.docker.internal:8000（不占宿主机新端口）。

DATA_CENTER_BASE_URL=http://host.docker.internal:8000
ZHIPU_API_KEY=

# 可选
